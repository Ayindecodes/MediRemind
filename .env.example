# Copy to .env.local and fill in. The server checks these when it starts (lib/env.ts).
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# Required. Signs login tokens; changing it signs everyone out. At least 32 characters:
#   openssl rand -base64 32
JWT_SECRET=

# Sends sign-in codes and other emails (https://resend.com/api-keys). Required in production.
# Without it in development, codes are printed to the dev server log instead.
RESEND_API_KEY=

# The app's public address, used for links in emails. Required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only needed once a scheduler calls the cron routes (Vercel Cron sends it as a Bearer token).
# At least 32 characters if set.
CRON_SECRET=

# Supabase, the database the app is moving to (not used by the app yet). Locally, run
# `npm run db:start`, then copy only API_URL, PUBLISHABLE_KEY and SECRET_KEY from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: full access to the database, bypassing its access rules. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Optional: store the JSON data somewhere other than ./data (the browser tests use this).
MEDIREMIND_DATA_DIR=
