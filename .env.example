# Copy to .env.local and fill in. The server checks these when it starts (lib/env.ts).
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# Required. Signs login tokens; changing it signs everyone out. At least 32 characters:
#   openssl rand -base64 32
JWT_SECRET=

# Sends sign-in codes and other emails (https://resend.com/api-keys). Required in production.
# Without it in development, codes are printed to the dev server log instead.
RESEND_API_KEY=

# The app's public address, used for links in emails. Required in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only needed once a scheduler calls the cron routes (Vercel Cron sends it as a Bearer token).
# At least 32 characters if set.
CRON_SECRET=

# Supabase, the database the app is moving to (not used by the app yet). Locally, run
# `npm run db:start`, then copy only API_URL, PUBLISHABLE_KEY and SECRET_KEY from `npm run db:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: full access to the database, bypassing its access rules. Never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Termii, which sends sign-in codes by SMS. All four come from the Termii dashboard. Without an API key,
# development prints each SMS in the dev server log instead; production can't sign anyone in.
TERMII_API_KEY=
# The base URL shown in your Termii dashboard, e.g. https://v3.api.termii.com
TERMII_BASE_URL=
# The sender ID Termii approved, 3 to 11 letters or digits
TERMII_SENDER_ID=MediRemind
# dnd (the default) reaches numbers on Do-Not-Disturb, which sign-in codes need; or generic
TERMII_CHANNEL=dnd

# Proves calls to the SMS hook come from Supabase. Locally it's the public value in supabase/config.toml
# ([auth.hook.send_sms]); for the hosted project, use the secret the dashboard shows for the hook.
SMS_HOOK_SECRET=v1,whsec_bWVkaXJlbWluZC1sb2NhbC1kZXZlbG9wbWVudC1vbmx5LXNtcy1ob29rLXNlY3JldA==

# Optional: store the JSON data somewhere other than ./data (the browser tests use this).
MEDIREMIND_DATA_DIR=
